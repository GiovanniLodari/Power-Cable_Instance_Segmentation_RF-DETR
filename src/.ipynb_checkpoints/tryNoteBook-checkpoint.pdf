   "source": [
    "# 1. Registrazione Dataset (Assicurati che il path sia corretto)\n",
    "DatasetCatalog.clear()\n",
    "MetadataCatalog.clear()\n",
    "data_root = \"/mnt/c/Users/giova/Downloads/progetto_cv_2025_2026/train\" # <--- CONTROLLA QUESTO PATH\n",
    "\n",
    "for split in ['train', 'val']:\n",
    "    DatasetCatalog.register(f\"ttpla_{split}\", lambda s=split: load_ttpla_dataset(data_root, s))\n",
    "    MetadataCatalog.get(f\"ttpla_{split}\").set(thing_classes=[\"cable\"])\n",
    "\n",
    "# 2. Funzione di Configurazione\n",
    "def setup_polar_config(output_dir):\n",
    "    cfg = get_cfg()\n",
    "    add_maskformer2_config(cfg)\n",
    "    \n",
    "    # Path del config base (Assicurati che il file esista nel path indicato)\n",
    "    config_file = project_root / 'Mask2Former' / 'configs' / 'coco/instance-segmentation/swin/maskformer2_swin_base_IN21k_384_bs16_50ep.yaml'\n",
    "    \n",
    "    # --- FIX: Allow new keys for legacy configs ---\n",
    "    cfg.set_new_allowed(True)\n",
    "    cfg.merge_from_file(str(config_file))\n",
    "    cfg.set_new_allowed(False)\n",
    "    # ----------------------------------------------\n",
    "    \n",
    "    # Custom Architecture\n",
    "    cfg.MODEL.META_ARCHITECTURE = \"PolarMaskFormer\"\n",
    "    cfg.MODEL.SEM_SEG_HEAD.NAME = \"PolarMaskFormerHead\"\n",
    "    \n",
    "    # Dataset\n",
    "    cfg.DATASETS.TRAIN = (\"ttpla_train\",)\n",
    "    cfg.DATASETS.TEST = (\"ttpla_val\",)\n",
    "    cfg.DATALOADER.NUM_WORKERS = 2 \n",
    "    \n",
    "    # Pesi iniziali (Backbone Swin pre-addestrato)\n",
    "    cfg.MODEL.WEIGHTS = \"/mnt/c/Users/giova/Desktop/VisionTranformer/tools/swin_base_converted.pkl\"\n",
    "    \n",
    "    # Parametri Modello\n",
    "    cfg.MODEL.MASK_FORMER.NUM_OBJECT_QUERIES = 100\n",
    "    cfg.MODEL.SEM_SEG_HEAD.NUM_CLASSES = 1 # Solo cavi\n",
    "    \n",
    "    # Parametri Training\n",
    "    cfg.SOLVER.IMS_PER_BATCH = 2      # Abbassa a 1 se hai errori di memoria (OOM)\n",
    "    cfg.SOLVER.BASE_LR = 0.0001\n",
    "    cfg.SOLVER.MAX_ITER = 1000        # Numero totale di step\n",
    "    cfg.SOLVER.CHECKPOINT_PERIOD = 200 # Salva ogni 200 step\n",
    "    \n",
    "    cfg.OUTPUT_DIR = output_dir\n",
    "    os.makedirs(cfg.OUTPUT_DIR, exist_ok=True)\n",
    "    \n",
    "    return cfg\n",
    "\n",
    "# 3. Impostazioni di Esecuzione\n",
    "OUTPUT_DIR = \"./output_polar_mask2former\"\n",
    "RESUME = True  # <--- METTI 'True' PER RIPRENDERE IL TRAINING, 'False' PER RICOMINCIARE\n",
    "\n",
    "# Setup\n",
    "cfg = setup_polar_config(OUTPUT_DIR)\n",
    "\n",
    "# Creazione del Trainer (Usa la nostra classe PolarTrainer definita nella Cella 4)\n",
    "trainer = PolarTrainer(cfg)\n",
    "\n",
    "# Avvio\n",
    "print(f\"🚀 Avvio Training (Resume={RESUME})...\")\n",
    "print(\"I grafici appariranno qui sotto ogni 20 step.\")\n",
    "\n",
    "# Se resume=True, cerca automaticamente 'last_checkpoint' nella cartella output\n",
    "trainer.resume_or_load(resume=RESUME)\n",
    "trainer.train()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Validation & Inference\n",
    "Visualizzazione risultati con fix per il device mismatch."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def visualize_polar_predictions(predictor, image_path, output_path, score_threshold=0.5):\n",
    "    img = cv2.imread(image_path)\n",
    "    outputs = predictor(img)\n",
    "    \n",
    "    # FIX: Move instances to CPU before filtering\n",
    "    instances = outputs[\"instances\"].to(\"cpu\")\n",
    "    instances = instances[instances.scores > score_threshold]\n",
    "    \n",
    "    # Print predicted polar coords\n",
    "    if hasattr(instances, 'pred_polars'):\n",
    "        print(\"Predicted Polars (rho, theta):\", instances.pred_polars)\n",
    "    \n",
    "    v = Visualizer(\n",
    "        img[:, :, ::-1],\n",
    "        metadata=MetadataCatalog.get(\"ttpla_val\"),\n",
    "        scale=1.0,\n",
    "        instance_mode=ColorMode.IMAGE_BW\n",
    "    )\n",
    "    \n",
    "    vis = v.draw_instance_predictions(instances)\n",
    "    vis_img = vis.get_image()[:, :, ::-1]\n",
    "    cv2.imwrite(output_path, vis_img)\n",
    "    return vis_img\n",
    "\n",
    "# Load final model\n",
    "cfg.MODEL.WEIGHTS = os.path.join(cfg.OUTPUT_DIR, \"model_final.pth\")\n",
    "predictor = DefaultPredictor(cfg)\n",
    "\n",
    "val_dataset = DatasetCatalog.get(\"ttpla_val\")\n",
    "if len(val_dataset) > 0:\n",
    "    img_path = val_dataset[0]['file_name']\n",
    "    print(f\"Visualizzazione su: {img_path}\")\n",
    "    vis_img = visualize_polar_predictions(predictor, img_path, \"polar_prediction.jpg\")\n",
    "    \n",
    "    import matplotlib.pyplot as plt\n",
    "    plt.figure(figsize=(12, 8))\n",
