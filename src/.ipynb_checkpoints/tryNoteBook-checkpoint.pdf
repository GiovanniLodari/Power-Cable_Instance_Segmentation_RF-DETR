      "File \u001b[0;32m/mnt/c/Users/giova/Desktop/VisionTranformer/wsl_venv/lib/python3.10/site-packages/detectron2/engine/defaults.py:519\u001b[0m, in \u001b[0;36mDefaultTrainer.build_optimizer\u001b[0;34m(cls, cfg, model)\u001b[0m\n\u001b[1;32m    510\u001b[0m \u001b[38;5;129m@classmethod\u001b[39m\n\u001b[1;32m    511\u001b[0m \u001b[38;5;28;01mdef\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[38;5;21mbuild_optimizer\u001b[39m(\u001b[38;5;28mcls\u001b[39m, cfg, model):\n\u001b[1;32m    512\u001b[0m \u001b[38;5;250m    \u001b[39m\u001b[38;5;124;03m\"\"\"\u001b[39;00m\n\u001b[1;32m    513\u001b[0m \u001b[38;5;124;03m    Returns:\u001b[39;00m\n\u001b[1;32m    514\u001b[0m \u001b[38;5;124;03m        torch.optim.Optimizer:\u001b[39;00m\n\u001b[0;32m   (...)\u001b[0m\n\u001b[1;32m    517\u001b[0m \u001b[38;5;124;03m    Overwrite it if you'd like a different optimizer.\u001b[39;00m\n\u001b[1;32m    518\u001b[0m \u001b[38;5;124;03m    \"\"\"\u001b[39;00m\n\u001b[0;32m--> 519\u001b[0m     \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[43mbuild_optimizer\u001b[49m\u001b[43m(\u001b[49m\u001b[43mcfg\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mmodel\u001b[49m\u001b[43m)\u001b[49m\n",
      "File \u001b[0;32m/mnt/c/Users/giova/Desktop/VisionTranformer/wsl_venv/lib/python3.10/site-packages/detectron2/solver/build.py:125\u001b[0m, in \u001b[0;36mbuild_optimizer\u001b[0;34m(cfg, model)\u001b[0m\n\u001b[1;32m    115\u001b[0m \u001b[38;5;250m\u001b[39m\u001b[38;5;124;03m\"\"\"\u001b[39;00m\n\u001b[1;32m    116\u001b[0m \u001b[38;5;124;03mBuild an optimizer from config.\u001b[39;00m\n\u001b[1;32m    117\u001b[0m \u001b[38;5;124;03m\"\"\"\u001b[39;00m\n\u001b[1;32m    118\u001b[0m params \u001b[38;5;241m=\u001b[39m get_default_optimizer_params(\n\u001b[1;32m    119\u001b[0m     model,\n\u001b[1;32m    120\u001b[0m     base_lr\u001b[38;5;241m=\u001b[39mcfg\u001b[38;5;241m.\u001b[39mSOLVER\u001b[38;5;241m.\u001b[39mBASE_LR,\n\u001b[0;32m   (...)\u001b[0m\n\u001b[1;32m    123\u001b[0m     weight_decay_bias\u001b[38;5;241m=\u001b[39mcfg\u001b[38;5;241m.\u001b[39mSOLVER\u001b[38;5;241m.\u001b[39mWEIGHT_DECAY_BIAS,\n\u001b[1;32m    124\u001b[0m )\n\u001b[0;32m--> 125\u001b[0m \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[43mmaybe_add_gradient_clipping\u001b[49m\u001b[43m(\u001b[49m\u001b[43mcfg\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mtorch\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43moptim\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mSGD\u001b[49m\u001b[43m)\u001b[49m(\n\u001b[1;32m    126\u001b[0m     params,\n\u001b[1;32m    127\u001b[0m     lr\u001b[38;5;241m=\u001b[39mcfg\u001b[38;5;241m.\u001b[39mSOLVER\u001b[38;5;241m.\u001b[39mBASE_LR,\n\u001b[1;32m    128\u001b[0m     momentum\u001b[38;5;241m=\u001b[39mcfg\u001b[38;5;241m.\u001b[39mSOLVER\u001b[38;5;241m.\u001b[39mMOMENTUM,\n\u001b[1;32m    129\u001b[0m     nesterov\u001b[38;5;241m=\u001b[39mcfg\u001b[38;5;241m.\u001b[39mSOLVER\u001b[38;5;241m.\u001b[39mNESTEROV,\n\u001b[1;32m    130\u001b[0m     weight_decay\u001b[38;5;241m=\u001b[39mcfg\u001b[38;5;241m.\u001b[39mSOLVER\u001b[38;5;241m.\u001b[39mWEIGHT_DECAY,\n\u001b[1;32m    131\u001b[0m )\n",
      "File \u001b[0;32m/mnt/c/Users/giova/Desktop/VisionTranformer/wsl_venv/lib/python3.10/site-packages/detectron2/solver/build.py:103\u001b[0m, in \u001b[0;36mmaybe_add_gradient_clipping\u001b[0;34m(cfg, optimizer)\u001b[0m\n\u001b[1;32m    100\u001b[0m     \u001b[38;5;28;01massert\u001b[39;00m \u001b[38;5;28missubclass\u001b[39m(optimizer, torch\u001b[38;5;241m.\u001b[39moptim\u001b[38;5;241m.\u001b[39mOptimizer), optimizer\n\u001b[1;32m    101\u001b[0m     optimizer_type \u001b[38;5;241m=\u001b[39m optimizer\n\u001b[0;32m--> 103\u001b[0m grad_clipper \u001b[38;5;241m=\u001b[39m \u001b[43m_create_gradient_clipper\u001b[49m\u001b[43m(\u001b[49m\u001b[43mcfg\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mSOLVER\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mCLIP_GRADIENTS\u001b[49m\u001b[43m)\u001b[49m\n\u001b[1;32m    104\u001b[0m OptimizerWithGradientClip \u001b[38;5;241m=\u001b[39m _generate_optimizer_class_with_gradient_clipping(\n\u001b[1;32m    105\u001b[0m     optimizer_type, per_param_clipper\u001b[38;5;241m=\u001b[39mgrad_clipper\n\u001b[1;32m    106\u001b[0m )\n\u001b[1;32m    107\u001b[0m \u001b[38;5;28;01mif\u001b[39;00m \u001b[38;5;28misinstance\u001b[39m(optimizer, torch\u001b[38;5;241m.\u001b[39moptim\u001b[38;5;241m.\u001b[39mOptimizer):\n",
      "File \u001b[0;32m/mnt/c/Users/giova/Desktop/VisionTranformer/wsl_venv/lib/python3.10/site-packages/detectron2/solver/build.py:41\u001b[0m, in \u001b[0;36m_create_gradient_clipper\u001b[0;34m(cfg)\u001b[0m\n\u001b[1;32m     35\u001b[0m     torch\u001b[38;5;241m.\u001b[39mnn\u001b[38;5;241m.\u001b[39mutils\u001b[38;5;241m.\u001b[39mclip_grad_value_(p, cfg\u001b[38;5;241m.\u001b[39mCLIP_VALUE)\n\u001b[1;32m     37\u001b[0m _GRADIENT_CLIP_TYPE_TO_CLIPPER \u001b[38;5;241m=\u001b[39m {\n\u001b[1;32m     38\u001b[0m     GradientClipType\u001b[38;5;241m.\u001b[39mVALUE: clip_grad_value,\n\u001b[1;32m     39\u001b[0m     GradientClipType\u001b[38;5;241m.\u001b[39mNORM: clip_grad_norm,\n\u001b[1;32m     40\u001b[0m }\n\u001b[0;32m---> 41\u001b[0m \u001b[38;5;28;01mreturn\u001b[39;00m _GRADIENT_CLIP_TYPE_TO_CLIPPER[\u001b[43mGradientClipType\u001b[49m\u001b[43m(\u001b[49m\u001b[43mcfg\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mCLIP_TYPE\u001b[49m\u001b[43m)\u001b[49m]\n",
      "File \u001b[0;32m/usr/lib/python3.10/enum.py:385\u001b[0m, in \u001b[0;36mEnumMeta.__call__\u001b[0;34m(cls, value, names, module, qualname, type, start)\u001b[0m\n\u001b[1;32m    360\u001b[0m \u001b[38;5;250m\u001b[39m\u001b[38;5;124;03m\"\"\"\u001b[39;00m\n\u001b[1;32m    361\u001b[0m \u001b[38;5;124;03mEither returns an existing member, or creates a new enum class.\u001b[39;00m\n\u001b[1;32m    362\u001b[0m \n\u001b[0;32m   (...)\u001b[0m\n\u001b[1;32m    382\u001b[0m \u001b[38;5;124;03m`type`, if set, will be mixed in as the first base class.\u001b[39;00m\n\u001b[1;32m    383\u001b[0m \u001b[38;5;124;03m\"\"\"\u001b[39;00m\n\u001b[1;32m    384\u001b[0m \u001b[38;5;28;01mif\u001b[39;00m names \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m:  \u001b[38;5;66;03m# simple value lookup\u001b[39;00m\n\u001b[0;32m--> 385\u001b[0m     \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[38;5;28;43mcls\u001b[39;49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[38;5;21;43m__new__\u001b[39;49m\u001b[43m(\u001b[49m\u001b[38;5;28;43mcls\u001b[39;49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mvalue\u001b[49m\u001b[43m)\u001b[49m\n\u001b[1;32m    386\u001b[0m \u001b[38;5;66;03m# otherwise, functional API: we're creating a new Enum type\u001b[39;00m\n\u001b[1;32m    387\u001b[0m \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[38;5;28mcls\u001b[39m\u001b[38;5;241m.\u001b[39m_create_(\n\u001b[1;32m    388\u001b[0m         value,\n\u001b[1;32m    389\u001b[0m         names,\n\u001b[0;32m   (...)\u001b[0m\n\u001b[1;32m    393\u001b[0m         start\u001b[38;5;241m=\u001b[39mstart,\n\u001b[1;32m    394\u001b[0m         )\n",
      "File \u001b[0;32m/usr/lib/python3.10/enum.py:710\u001b[0m, in \u001b[0;36mEnum.__new__\u001b[0;34m(cls, value)\u001b[0m\n\u001b[1;32m    708\u001b[0m ve_exc \u001b[38;5;241m=\u001b[39m \u001b[38;5;167;01mValueError\u001b[39;00m(\u001b[38;5;124m\"\u001b[39m\u001b[38;5;132;01m%r\u001b[39;00m\u001b[38;5;124m is not a valid \u001b[39m\u001b[38;5;132;01m%s\u001b[39;00m\u001b[38;5;124m\"\u001b[39m \u001b[38;5;241m%\u001b[39m (value, \u001b[38;5;28mcls\u001b[39m\u001b[38;5;241m.\u001b[39m\u001b[38;5;18m__qualname__\u001b[39m))\n\u001b[1;32m    709\u001b[0m \u001b[38;5;28;01mif\u001b[39;00m result \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m \u001b[38;5;129;01mand\u001b[39;00m exc \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m:\n\u001b[0;32m--> 710\u001b[0m     \u001b[38;5;28;01mraise\u001b[39;00m ve_exc\n\u001b[1;32m    711\u001b[0m \u001b[38;5;28;01melif\u001b[39;00m exc \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m:\n\u001b[1;32m    712\u001b[0m     exc \u001b[38;5;241m=\u001b[39m \u001b[38;5;167;01mTypeError\u001b[39;00m(\n\u001b[1;32m    713\u001b[0m             \u001b[38;5;124m'\u001b[39m\u001b[38;5;124merror in \u001b[39m\u001b[38;5;132;01m%s\u001b[39;00m\u001b[38;5;124m._missing_: returned \u001b[39m\u001b[38;5;132;01m%r\u001b[39;00m\u001b[38;5;124m instead of None or a valid member\u001b[39m\u001b[38;5;124m'\u001b[39m\n\u001b[1;32m    714\u001b[0m             \u001b[38;5;241m%\u001b[39m (\u001b[38;5;28mcls\u001b[39m\u001b[38;5;241m.\u001b[39m\u001b[38;5;18m__name__\u001b[39m, result)\n\u001b[1;32m    715\u001b[0m             )\n",
      "\u001b[0;31mValueError\u001b[0m: 'full_model' is not a valid GradientClipType"
     ]
