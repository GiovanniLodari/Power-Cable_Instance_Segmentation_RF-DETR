   "source": [
    "## 2. Dataset Loading & Mapper\n",
    "Caricamento dataset e custom mapper (invariato)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_ttpla_dataset(root_dir: str, split: str = 'train', val_split: float = 0.2):\n",
    "    root_path = Path(root_dir)\n",
    "    json_file = root_path / 'train.json'\n",
    "    with open(json_file, 'r') as f:\n",
    "        coco_data = json.load(f)\n",
    "    \n",
    "    all_images = sorted(coco_data['images'], key=lambda x: x['id'])\n",
    "    num_val = int(len(all_images) * val_split)\n",
    "    images = all_images[:num_val] if split == 'val' else all_images[num_val:]\n",
    "    \n",
    "    valid_img_ids = {img['id'] for img in images}\n",
    "    img_to_anns = {}\n",
    "    for ann in coco_data['annotations']:\n",
    "        if ann['image_id'] in valid_img_ids:\n",
    "            img_to_anns.setdefault(ann['image_id'], []).append(ann)\n",
    "    \n",
    "    dataset_dicts = []\n",
    "    for img_info in images:\n",
    "        record = {\n",
    "            \"file_name\": str(root_path / img_info['file_name']),\n",
    "            \"image_id\": img_info['id'],\n",
    "            \"height\": img_info['height'],\n",
    "            \"width\": img_info['width']\n",
    "        }\n",
    "        objs = []\n",
    "        for ann in img_to_anns.get(img_info['id'], []):\n",
    "            segmentation = ann['segmentation']\n",
    "            if isinstance(segmentation, dict): # RLE\n",
    "                from pycocotools import mask as mask_utils\n",
    "                mask = mask_utils.decode(segmentation)\n",
    "                contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n",
    "                polygons = [c.flatten().tolist() for c in contours if len(c) >= 3]\n",
    "            else:\n",
    "                polygons = segmentation\n",
    "            \n",
    "            polar_coords = [0.0, 0.0]\n",
    "            if 'polar_coordinates' in ann and len(ann['polar_coordinates']) > 0:\n",
    "                p = ann['polar_coordinates'][0]\n",
    "                polar_coords = [float(p.get('rho', 0.0)), float(p.get('theta', 0.0))]\n",
    "\n",
    "            objs.append({\n",
    "                \"bbox\": ann['bbox'],\n",
    "                \"bbox_mode\": 1, # XYWH_ABS\n",
    "                \"segmentation\": polygons,\n",
    "                \"category_id\": 0,\n",
    "                \"polar_coordinates\": polar_coords\n",
    "            })\n",
    "        record[\"annotations\"] = objs\n",
    "        dataset_dicts.append(record)\n",
    "    return dataset_dicts\n",
    "\n",
    "def custom_mapper(dataset_dict):\n",
    "    dataset_dict = copy.deepcopy(dataset_dict)\n",
    "    image = utils.read_image(dataset_dict[\"file_name\"], format=\"BGR\")\n",
    "    \n",
    "    augs = T.AugmentationList([\n",
    "        T.RandomFlip(prob=0.5),\n",
    "        T.ResizeShortestEdge(short_edge_length=(640, 672, 704, 736, 768, 800), max_size=1333, sample_style=\"choice\"),\n",
    "    ])\n",
    "    aug_input = T.AugInput(image)\n",
    "    transforms = augs(aug_input)\n",
    "    image = aug_input.image\n",
    "    dataset_dict[\"image\"] = torch.as_tensor(image.transpose(2, 0, 1).astype(\"float32\"))\n",
    "\n",
    "    annos = [\n",
    "        utils.transform_instance_annotations(obj, transforms, image.shape[:2])\n",
    "        for obj in dataset_dict.pop(\"annotations\")\n",
    "    ]\n",
    "    instances = utils.annotations_to_instances(annos, image.shape[:2])\n",
    "    \n",
    "    if len(annos) > 0:\n",
    "        instances.gt_polars = torch.tensor([ann.get('polar_coordinates', [0.0, 0.0]) for ann in annos], dtype=torch.float32)\n",
    "        \n",
    "        # Convert PolygonMasks to BitMasks for Mask2Former compatibility\n",
    "        if hasattr(instances, 'gt_masks') and isinstance(instances.gt_masks, PolygonMasks):\n",
    "            instances.gt_masks = instances.gt_masks.get_bit_masks(instances.image_size[0], instances.image_size[1])\n",
    "            instances.gt_masks = BitMasks(instances.gt_masks)\n",
    "\n",
    "    instances = utils.filter_empty_instances(instances)\n",
    "    \n",
    "    # Convert BitMasks to tensor\n",
    "    if hasattr(instances, 'gt_masks') and isinstance(instances.gt_masks, BitMasks):\n",
    "        instances.gt_masks = instances.gt_masks.tensor\n",
    "\n",
    "    dataset_dict[\"instances\"] = instances\n",
    "    return dataset_dict"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Architecture Definition\n",
    "Qui definiamo le classi custom per integrare la PolarHead:\n",
    "1. `PolarHead`: Modulo MLP per predire (rho, theta)\n",
    "2. `PolarTransformerDecoder`: Estende il decoder per ritornare gli embeddings\n",
    "3. `PolarMaskFormerHead`: Usa il nuovo decoder e la PolarHead\n",
    "4. `PolarSetCriterion`: Calcola anche la loss polare\n",
    "5. `PolarMaskFormer`: Meta-architettura che assembla tutto"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3.1 PolarHead\n",
    "class PolarHead(nn.Module):\n",
    "    def __init__(self, input_dim, hidden_dim=256):\n",
    "        super().__init__()\n",
    "        self.layers = nn.Sequential(\n",
    "            nn.Linear(input_dim, hidden_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(hidden_dim, hidden_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(hidden_dim, 2)  # rho, theta\n",
    "        )\n",
    "    \n",
    "    def forward(self, x):\n",
    "        return self.layers(x)\n",
    "\n",
    "# 3.2 PolarTransformerDecoder\n",
    "class PolarTransformerDecoder(MultiScaleMaskedTransformerDecoder):\n",
    "    def forward(self, x, mask_features, mask=None):\n",
    "        # Copia quasi esatta del forward originale, ma ritorna anche 'pred_polars'\n",
    "        assert len(x) == self.num_feature_levels\n",
    "        src = []\n",
    "        pos = []\n",
    "        size_list = []\n",
    "        del mask\n",
    "\n",
    "        for i in range(self.num_feature_levels):\n",
    "            size_list.append(x[i].shape[-2:])\n",
    "            pos.append(self.pe_layer(x[i], None).flatten(2))\n",
    "            src.append(self.input_proj[i](x[i]).flatten(2) + self.level_embed.weight[i][None, :, None])\n",
    "            pos[-1] = pos[-1].permute(2, 0, 1)\n",
    "            src[-1] = src[-1].permute(2, 0, 1)\n",
    "\n",
    "        _, bs, _ = src[0].shape\n",
    "        query_embed = self.query_embed.weight.unsqueeze(1).repeat(1, bs, 1)\n",
    "        output = self.query_feat.weight.unsqueeze(1).repeat(1, bs, 1)\n",
    "\n",
    "        predictions_class = []\n",
    "        predictions_mask = []\n",
    "        predictions_polar = [] # NEW\n",
    "\n",
    "        # Initial prediction\n",
    "        outputs_class, outputs_mask, attn_mask, decoder_output = self.forward_prediction_heads_with_embed(output, mask_features, size_list[0])\n",
    "        predictions_class.append(outputs_class)\n",
    "        predictions_mask.append(outputs_mask)\n",
    "        predictions_polar.append(decoder_output) # We will apply PolarHead later or return embeddings\n",
    "\n",
    "        for i in range(self.num_layers):\n",
    "            level_index = i % self.num_feature_levels\n",
    "            attn_mask[torch.where(attn_mask.sum(-1) == attn_mask.shape[-1])] = False\n",
    "            output = self.transformer_cross_attention_layers[i](\n",
    "                output, src[level_index],\n",
    "                memory_mask=attn_mask,\n",
    "                memory_key_padding_mask=None,\n",
    "                pos=pos[level_index], query_pos=query_embed\n",
    "            )\n",
    "            output = self.transformer_self_attention_layers[i](\n",
    "                output, tgt_mask=None,\n",
    "                tgt_key_padding_mask=None,\n",
    "                query_pos=query_embed\n",
    "            )\n",
    "            output = self.transformer_ffn_layers[i](output)\n",
    "\n",
    "            outputs_class, outputs_mask, attn_mask, decoder_output = self.forward_prediction_heads_with_embed(output, mask_features, size_list[(i + 1) % self.num_feature_levels])\n",
    "            predictions_class.append(outputs_class)\n",
    "            predictions_mask.append(outputs_mask)\n",
    "            predictions_polar.append(decoder_output)\n",
    "\n",
    "        out = {\n",
    "            'pred_logits': predictions_class[-1],\n",
    "            'pred_masks': predictions_mask[-1],\n",
    "            'pred_embeddings': predictions_polar[-1], # Return final embeddings\n",
    "            'aux_outputs': self._set_aux_loss(predictions_class, predictions_mask)\n",
    "        }\n",
    "        return out\n",
    "\n",
    "    def forward_prediction_heads_with_embed(self, output, mask_features, attn_mask_target_size):\n",
    "        decoder_output = self.decoder_norm(output)\n",
    "        decoder_output = decoder_output.transpose(0, 1)\n",
    "        outputs_class = self.class_embed(decoder_output)\n",
    "        mask_embed = self.mask_embed(decoder_output)\n",
    "        outputs_mask = torch.einsum(\"bqc,bchw->bqhw\", mask_embed, mask_features)\n",
    "\n",
    "        attn_mask = F.interpolate(outputs_mask, size=attn_mask_target_size, mode=\"bilinear\", align_corners=False)\n",
    "        attn_mask = (attn_mask.sigmoid().flatten(2).unsqueeze(1).repeat(1, self.num_heads, 1, 1).flatten(0, 1) < 0.5).bool()\n",
    "        attn_mask = attn_mask.detach()\n",
    "\n",
    "        return outputs_class, outputs_mask, attn_mask, decoder_output\n",
    "\n",
    "# 3.3 PolarMaskFormerHead\n",
    "@SEM_SEG_HEADS_REGISTRY.register()\n",
    "class PolarMaskFormerHead(MaskFormerHead):\n",
    "    @configurable\n",
    "    def __init__(self, input_shape, **kwargs):\n",
    "        super().__init__(input_shape, **kwargs)\n",
    "        # Add PolarHead\n",
    "        # Hidden dim is typically 256 for Swin-Base config\n",
    "        self.polar_head = PolarHead(256)\n",
    "\n",
    "    @classmethod\n",
    "    def from_config(cls, cfg, input_shape):\n",
    "        ret = super().from_config(cfg, input_shape)\n",
    "        # Override predictor with our custom one\n",
    "        ret[\"transformer_predictor\"] = PolarTransformerDecoder(\n",
    "            cfg.MODEL.SEM_SEG_HEAD.CONVS_DIM if cfg.MODEL.MASK_FORMER.TRANSFORMER_IN_FEATURE == \"multi_scale_pixel_decoder\" else input_shape[cfg.MODEL.MASK_FORMER.TRANSFORMER_IN_FEATURE].channels,\n",
    "            mask_classification=True,\n",
    "            num_classes=cfg.MODEL.SEM_SEG_HEAD.NUM_CLASSES,\n",
    "            hidden_dim=cfg.MODEL.MASK_FORMER.HIDDEN_DIM,\n",
    "            num_queries=cfg.MODEL.MASK_FORMER.NUM_OBJECT_QUERIES,\n",
    "            nheads=cfg.MODEL.MASK_FORMER.NHEADS,\n",
    "            dim_feedforward=cfg.MODEL.MASK_FORMER.DIM_FEEDFORWARD,\n",
    "            dec_layers=cfg.MODEL.MASK_FORMER.DEC_LAYERS - 1,\n",
    "            pre_norm=cfg.MODEL.MASK_FORMER.PRE_NORM,\n",
    "            mask_dim=cfg.MODEL.SEM_SEG_HEAD.MASK_DIM,\n",
    "            enforce_input_project=cfg.MODEL.MASK_FORMER.ENFORCE_INPUT_PROJ,\n",
    "        )\n",
    "        return ret\n",
    "\n",
    "    def forward(self, features, mask=None):\n",
    "        outputs = self.layers(features, mask)\n",
    "        # outputs has 'pred_embeddings'\n",
    "        embeddings = outputs.pop('pred_embeddings')\n",
    "        # Predict polars\n",
    "        pred_polars = self.polar_head(embeddings)\n",
    "        outputs['pred_polars'] = pred_polars\n",
    "        return outputs\n",
    "\n",
    "# 3.4 PolarSetCriterion\n",
    "class PolarSetCriterion(SetCriterion):\n",
    "    def __init__(self, *args, **kwargs):\n",
    "        super().__init__(*args, **kwargs)\n",
    "        self.losses.append(\"polar\") # Add polar loss to list\n",
    "\n",
    "    def loss_polar(self, outputs, targets, indices, num_masks):\n",
    "        assert \"pred_polars\" in outputs\n",
    "        src_polars = outputs[\"pred_polars\"]\n",
    "        src_idx = self._get_src_permutation_idx(indices)\n",
    "        \n",
    "        src_polars = src_polars[src_idx]\n",
    "        target_polars = torch.cat([t[\"polar_coordinates\"][i] for t, (_, i) in zip(targets, indices)], dim=0)\n",
    "        \n",
    "        loss_polar = F.mse_loss(src_polars, target_polars, reduction='none')\n",
    "        loss_polar = loss_polar.sum() / num_masks\n",
    "        return {\"loss_polar\": loss_polar}\n",
    "\n",
    "    def get_loss(self, loss, outputs, targets, indices, num_masks):\n",
    "        if loss == 'polar':\n",
    "            return self.loss_polar(outputs, targets, indices, num_masks)\n",
    "        return super().get_loss(loss, outputs, targets, indices, num_masks)\n",
    "\n",
    "# 3.5 PolarMaskFormer (Meta Arch)\n",
    "from mask2former.maskformer_model import MaskFormer\n",
    "\n",
    "@META_ARCH_REGISTRY.register()\n",
    "class PolarMaskFormer(MaskFormer):\n",
    "    @classmethod\n",
    "    def from_config(cls, cfg):\n",
    "        ret = super().from_config(cfg)\n",
    "        # Replace criterion with PolarSetCriterion\n",
    "        matcher = HungarianMatcher(\n",
    "            cost_class=cfg.MODEL.MASK_FORMER.CLASS_WEIGHT,\n",
    "            cost_mask=cfg.MODEL.MASK_FORMER.MASK_WEIGHT,\n",
    "            cost_dice=cfg.MODEL.MASK_FORMER.DICE_WEIGHT,\n",
    "            num_points=cfg.MODEL.MASK_FORMER.TRAIN_NUM_POINTS,\n",
    "        )\n",
    "        weight_dict = {\"loss_ce\": cfg.MODEL.MASK_FORMER.CLASS_WEIGHT, \n",
    "                       \"loss_mask\": cfg.MODEL.MASK_FORMER.MASK_WEIGHT, \n",
    "                       \"loss_dice\": cfg.MODEL.MASK_FORMER.DICE_WEIGHT,\n",
    "                       \"loss_polar\": 1.0} # Polar Loss Weight\n",
    "        \n",
    "        if cfg.MODEL.MASK_FORMER.DEEP_SUPERVISION:\n",
    "            dec_layers = cfg.MODEL.MASK_FORMER.DEC_LAYERS\n",
    "            aux_weight_dict = {}\n",
    "            for i in range(dec_layers - 1):\n",
    "                aux_weight_dict.update({k + f\"_{i}\": v for k, v in weight_dict.items()})\n",
    "            weight_dict.update(aux_weight_dict)\n",
    "\n",
    "        criterion = PolarSetCriterion(\n",
    "            ret[\"sem_seg_head\"].num_classes,\n",
    "            matcher=matcher,\n",
    "            weight_dict=weight_dict,\n",
    "            eos_coef=cfg.MODEL.MASK_FORMER.NO_OBJECT_WEIGHT,\n",
    "            losses=[\"labels\", \"masks\", \"polar\"],\n",
    "            num_points=cfg.MODEL.MASK_FORMER.TRAIN_NUM_POINTS,\n",
    "            oversample_ratio=cfg.MODEL.MASK_FORMER.OVERSAMPLE_RATIO,\n",
    "            importance_sample_ratio=cfg.MODEL.MASK_FORMER.IMPORTANCE_SAMPLE_RATIO,\n",
    "        )\n",
    "        ret[\"criterion\"] = criterion\n",
    "        return ret\n",
    "\n",
    "    def prepare_targets(self, targets, images):\n",
    "        h_pad, w_pad = images.tensor.shape[-2:]\n",
    "        new_targets = []\n",
    "        for targets_per_image in targets:\n",
    "            gt_masks = targets_per_image.gt_masks\n",
    "            # Assicura device corretto\n",
    "            padded_masks = torch.zeros((gt_masks.shape[0], h_pad, w_pad), dtype=gt_masks.dtype, device=gt_masks.device)\n",
    "            padded_masks[:, : gt_masks.shape[1], : gt_masks.shape[2]] = gt_masks\n",
    "            \n",
    "            new_targets.append(\n",
    "                {\n",
    "                    \"labels\": targets_per_image.gt_classes,\n",
    "                    \"masks\": padded_masks,\n",
    "                    \"polar_coordinates\": targets_per_image.gt_polars.to(gt_masks.device) # <--- Explicit device move\n",
    "                }\n",
    "            )\n",
    "        return new_targets"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Custom Train & Visualize"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✅ Custom Trainer definito con successo.\n"
     ]
    }
   ],
   "source": [
    "# --- CELLA 4: Custom Trainer e Visualization Hook ---\n",
    "from detectron2.engine import HookBase\n",
    "from detectron2.utils.events import get_event_storage\n",
    "from rich.console import Console\n",
    "from rich.table import Table\n",
    "import matplotlib.pyplot as plt\n",
    "from IPython.display import clear_output\n",
    "\n",
    "class RichLossPlotterHook(HookBase):\n",
    "    \"\"\"\n",
    "    Questo Hook viene chiamato alla fine di ogni iterazione (o step).\n",
    "    Si occupa di:\n",
    "    1. Leggere le loss correnti dallo storage di Detectron2.\n",
    "    2. Aggiornare una tabella Rich.\n",
    "    3. Disegnare i grafici live con Matplotlib.\n",
    "    \"\"\"\n",
    "    def __init__(self, plot_interval=20):\n",
    "        self._plot_interval = plot_interval\n",
    "        # Dizionario per memorizzare la storia delle loss\n",
    "        self._history = {\"total_loss\": [], \"loss_polar\": [], \"loss_mask\": [], \"loss_ce\": [], \"loss_dice\": []}\n",
    "        self._console = Console()\n",
    "        \n",
    "    def after_step(self):\n",
    "        storage = get_event_storage()\n",
    "        \n",
    "        # Eseguiamo l'aggiornamento solo ogni 'plot_interval' step per non rallentare troppo\n",
    "        if storage.iter % self._plot_interval == 0:\n",
    "            latest_metrics = storage.latest()\n",
    "            \n",
    "            # Salviamo i dati per i grafici\n",
    "            if \"total_loss\" in latest_metrics:\n",
    "                self._history[\"total_loss\"].append(latest_metrics[\"total_loss\"][0])\n",
    "            if \"loss_polar\" in latest_metrics:\n",
    "                self._history[\"loss_polar\"].append(latest_metrics[\"loss_polar\"][0])\n",
    "            if \"loss_mask\" in latest_metrics:\n",
    "                self._history[\"loss_mask\"].append(latest_metrics[\"loss_mask\"][0])\n",
    "            \n",
    "            # --- Visualizzazione ---\n",
    "            clear_output(wait=True) # Pulisce l'output della cella precedente\n",
    "            \n",
    "            # 1. Creiamo la Tabella Rich\n",
    "            table = Table(title=f\"Training Status - Iter {storage.iter}\")\n",
    "            table.add_column(\"Metric\", style=\"cyan\")\n",
    "            table.add_column(\"Value\", style=\"magenta\")\n",
    "            \n",
    "            for k, v in latest_metrics.items():\n",
    "                if \"loss\" in k: # Mostriamo solo le metriche di loss\n",
    "                    val = v[0]\n",
    "                    table.add_row(k, f\"{val:.4f}\")\n",
    "            \n",
    "            self._console.print(table)\n",
    "            \n",
    "            # 2. Disegniamo i Grafici\n",
    "            if len(self._history[\"total_loss\"]) > 1:\n",
    "                fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 5))\n",
    "                \n",
    "                # Grafico 1: Loss Totale\n",
    "                ax1.plot(self._history[\"total_loss\"], label=\"Total Loss\", color='red')\n",
    "                ax1.set_title(\"Total Loss Trend\")\n",
    "                ax1.set_xlabel(f\"Steps (x{self._plot_interval})\")\n",
    "                ax1.set_ylabel(\"Loss\")\n",
    "                ax1.grid(True, alpha=0.3)\n",
    "                ax1.legend()\n",
    "                \n",
    "                # Grafico 2: Loss Specifiche (Polar vs Mask)\n",
    "                if len(self._history[\"loss_polar\"]) > 0:\n",
    "                    ax2.plot(self._history[\"loss_polar\"], label=\"Polar Loss\", color='blue')\n",
    "                if len(self._history[\"loss_mask\"]) > 0:\n",
    "                    ax2.plot(self._history[\"loss_mask\"], label=\"Mask Loss\", color='green')\n",
    "                \n",
    "                ax2.set_title(\"Component Losses\")\n",
    "                ax2.set_xlabel(f\"Steps (x{self._plot_interval})\")\n",
    "                ax2.grid(True, alpha=0.3)\n",
    "                ax2.legend()\n",
    "                \n",
    "                plt.show()\n",
    "\n",
    "# Definiamo il Trainer che usa questo Hook\n",
    "class PolarTrainer(DefaultTrainer):\n",
    "    def build_hooks(self):\n",
    "        # Carica gli hook standard di Detectron2 (checkpoint, timer, etc.)\n",
    "        hooks = super().build_hooks()\n",
    "        # Aggiunge il nostro hook personalizzato\n",
    "        hooks.insert(-1, RichLossPlotterHook(plot_interval=20)) \n",
    "        return hooks\n",
    "\n",
    "print(\"✅ Custom Trainer definito con successo.\")"
   ]
  },
